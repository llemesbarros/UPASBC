{
  "manifest_version": 3,
  "name": "SisATIH - Preenchimento por PDF",
  "version": "0.1.0",
  "description": "Extrai localmente dados de fichas PDF do Hygia e auxilia o preenchimento das telas do SisATIH.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://regulacao.saobernardo.sp.gov.br/sisatih/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://regulacao.saobernardo.sp.gov.br/sisatih/a/solicitacao/nova*"
      ],
      "js": ["parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
